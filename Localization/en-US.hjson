Mods: {
	ModernRecipeBook: {
		Keybinds: {
			ToggleBook.DisplayName: Open Recipe Book
			ChainBack.DisplayName: Chain Back
			ChainForward.DisplayName: Chain Forward
		}

		Configs: {
			BookConfig: {
				DisplayName: Recipe Book

				WindowScalePercent: {
					Label: Window Size (%)
					Tooltip: Default 90%. Shrinks to fit small screens.
				}

				TextScalePercent: {
					Label: Text Size (%)
					Tooltip: Default 100%. Changes text only, not the window.
				}

				InventoryAltRightClick: {
					Label: Middle-Click Item Search
					Tooltip: Middle-click an item in any slot to open it in the book. Elsewhere Mouse3 opens the book.
				}

				TrackerOpacityPercent: {
					Label: Tracking Overlay Opacity (%)
					Tooltip: Background only; text and icons stay solid.
				}

				TrackerScalePercent: {
					Label: Tracking Overlay Size (%)
					Tooltip: 100% is a 300 px wide overlay. Shrinks to fit the screen.
				}

				ResourceOnlyTracker: {
					Label: Tracking Overlay: Materials Only
					Tooltip: One list of the materials all goals still need. Always on with more than 5 goals.
				}
			}
		}
	}
}
