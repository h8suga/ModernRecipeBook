BookConfig: {
	DisplayName: Книга рецептов

	WindowScalePercent: {
		Label: Размер окна, %
		Tooltip: По умолчанию 90%. Уменьшается, если не помещается на экране.
	}

	TextScalePercent: {
		Label: Размер текста, %
		Tooltip: По умолчанию 100%. Меняет только текст, не окно.
	}

	InventoryAltRightClick: {
		Label: Поиск предмета средней кнопкой
		Tooltip: Средняя кнопка по предмету в любом слоте показывает его (см. «Средняя кнопка по предмету»). В остальных местах Mouse3 открывает книгу.
	}

	ItemClickAction: {
		Label: Средняя кнопка по предмету
		Tooltip:
			'''
			Открыть в книге: карточка предмета.
			Быстрый поиск: поиск с полным названием предмета, сам предмет первым и выделен, с источниками и действиями.
			'''
	}

	TrackerOpacityPercent: {
		Label: Непрозрачность панели отслеживания, %
		Tooltip: Только фон панели с карточками; текст и иконки всегда чёткие.
	}

	TrackerScalePercent: {
		Label: Размер панели отслеживания, %
		Tooltip: Только для карточек; компактные строки — размером текста игры.
	}

	ResourceOnlyTracker: {
		Label: Отслеживание: компактные строки
		Tooltip: Строки материалов под миникартой, как у аксессуара. Выкл.: карточки, до 5 целей.
	}

	Headers.Movement: Движение

	DoubleTapDash: {
		Label: Рывок двойным нажатием (Calamity)
		Tooltip: Двойное нажатие влево или вправо делает рывок, клавиша рывка Calamity тоже работает.
	}
}

BookItemClickAction: {
	OpenInBook: {
		Label: Открыть в книге
		// Tooltip: ""
	}

	QuickSearch: {
		Label: Быстрый поиск
		// Tooltip: ""
	}

	// Tooltip: ""
}

BookServerConfig: {
	DisplayName: Книга рецептов: сервер
	Headers.QualityOfLife: Удобства

	NearbyStorage: {
		Label: Хранилища рядом
		Tooltip: Книга показывает и считает то, что лежит в сундуках и Magic Storage в радиусе, и создаёт из этого предметы.
	}

	NearbyRadius: {
		Label: Радиус хранилищ (блоков)
		Tooltip: По умолчанию 30 блоков вокруг игрока.
	}

	MapTeleport: {
		Label: Телепорт по карте
		Tooltip:
			'''
			Колёсико (Mouse3) по исследованной точке большой карты — телепорт туда.
			Клавиша меняется в управлении.
			'''
	}

	MapMarkers: {
		Label: Общие метки на карте
		Tooltip:
			'''
			Метки, которые видят все на сервере; хранятся в мире.
			ПКМ по большой карте — поставить, ПКМ по метке — изменить или удалить.
			'''
	}
}
