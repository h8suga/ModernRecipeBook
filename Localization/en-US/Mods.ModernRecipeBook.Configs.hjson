BookConfig: {
	DisplayName: Recipe Book

	WindowScalePercent: {
		Label: Window Size (%)
		Tooltip: Default 90%. Shrinks to fit small screens.
	}

	TextScalePercent: {
		Label: Text Size (%)
		Tooltip: Default 100%. Changes text only, not the window.
	}

	InventoryAltRightClick: {
		Label: Middle-Click Item Search
		Tooltip: Middle-click an item in any slot to look it up (see Middle-Click on an Item). Elsewhere Mouse3 opens the book.
	}

	ItemClickAction: {
		Label: Middle-Click on an Item
		Tooltip:
			'''
			Open in the Book: the item's card.
			Quick Search: the quick search with the item's full name, the item first and selected, with its sources and actions.
			'''
	}

	TrackerOpacityPercent: {
		Label: Tracking Cards Opacity (%)
		Tooltip: Background of the cards panel; text and icons stay solid.
	}

	TrackerScalePercent: {
		Label: Tracking Cards Size (%)
		Tooltip: Cards panel only; compact lines use the game's text size.
	}

	ResourceOnlyTracker: {
		Label: Tracking Overlay: Compact Lines
		Tooltip: Material lines under the minimap, like an info accessory. Off: cards for up to 5 goals.
	}

	Headers: {
		Movement: Movement
		AfterDeath: After Death
	}

	DoubleTapDash: {
		Label: Double-Tap Dash (Calamity)
		Tooltip: Double-tap left or right to dash; Calamity's dash key keeps working.
	}

	ResummonMinionsAfterDeath: {
		Label: Resummon Minions After Death
		Tooltip:
			'''
			On respawn, the minions you died with come back, the same ones and as many.
			The staff doesn't have to be in your inventory, and no mana is spent.
			'''
	}

	KeepTableBuffsAfterDeath: {
		Label: Keep Table Buffs After Death
		Tooltip:
			'''
			Bewitching Table and War Table buffs come back on respawn with the time they had left.
			No need to click the tables again.
			'''
	}
}

BookItemClickAction: {
	OpenInBook: {
		Label: Open in the Book
		Tooltip: The item's card in the book.
	}

	QuickSearch: {
		Label: Quick Search
		Tooltip: The quick search with the item's full name, the item first and selected.
	}

	Tooltip: What middle-clicking an item opens.
}

BookServerConfig: {
	DisplayName: Recipe Book: Server
	Headers.QualityOfLife: Quality of Life

	NearbyStorage: {
		Label: Nearby Storage
		Tooltip: The book shows, counts and crafts from chests and Magic Storage within the radius.
	}

	NearbyRadius: {
		Label: Nearby Storage Radius (tiles)
		Tooltip: Default 30 tiles around the player.
	}

	MapTeleport: {
		Label: Map Teleport
		Tooltip:
			'''
			Mouse3 / middle click on an explored spot of the full map teleports you there.
			Rebindable in Controls.
			'''
	}

	MapMarkers: {
		Label: Shared Map Markers
		Tooltip:
			'''
			Markers everyone on the server sees, kept with the world.
			Right-click the full map to place one, right-click a marker to edit or delete it.
			'''
	}
}
