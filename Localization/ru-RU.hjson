Mods: {
	ModernRecipeBook: {
		Keybinds: {
			ToggleBook.DisplayName: Открыть / закрыть книгу рецептов
			ChainBack.DisplayName: Цепочка: назад
			ChainForward.DisplayName: Цепочка: вперёд
		}

		Configs: {
			BookConfig: {
				DisplayName: Книга рецептов — интерфейс

				WindowScalePercent: {
					Label: Размер окна, %
					Tooltip: 90% по умолчанию. Размер книги не зависит от масштаба интерфейса Terraria. Окно автоматически уменьшается, если не помещается на экране.
				}

				TextScalePercent: {
					Label: Размер текста, %
					Tooltip: 100% по умолчанию. Меняет только текст, не увеличивая окно, иконки и зоны нажатия. В тесных элементах размер ограничен их высотой. Длинные подписи сокращаются; полный текст доступен при наведении.
				}

				InventoryAltRightClick: {
					Label: Mouse3 — быстрый поиск по предмету
					Tooltip: Средняя кнопка над предметом в любом стандартном слоте: инвентарь, сундук, броня, аксессуары, косметика, красители, банки, магазин, Гид, перековка и материалы. Для нестандартных окон модов используется подсказка предмета, если мод передаёт её Terraria. Предметы не перемещаются. Shift/Ctrl/Alt и геймпад не перехватываются. Вне предмета Mouse3 открывает/закрывает книгу, если назначен в управлении.
				}

				TrackerOpacityPercent: {
					Label: Непрозрачность панели крафта, %
					Tooltip: Меняет только фон и рамки. Иконки, текст и обводка всегда непрозрачные, включая исчезновение. Стиль «только ресурсы» — без фоновой панели.
				}

				TrackerScalePercent: {
					Label: Размер панели крафта, %
					Tooltip: 100% — компактная панель шириной 300 пикселей. Диапазон 60–150%. Не зависит от масштаба интерфейса Terraria; автоматически уменьшается, если не помещается на экране. Названия целиком — при наведении; длинные списки материалов листаются стрелками.
				}

				ResourceOnlyTracker: {
					Label: Стиль трекера: только ресурсы
					Tooltip: Выкл. — до 5 карточек целей. Вкл. — ресурсный HUD без лимита добавленных крафтов. Потребности суммируются; один звук только за весь собранный список. Удаление отдельных целей — вкладка «Трекер» (Ctrl+6). Если целей больше пяти, ресурсный стиль сохраняется до удаления лишних целей, даже при выключении этой настройки.
				}
			}
		}
	}
}
