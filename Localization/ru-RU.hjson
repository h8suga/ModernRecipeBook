Mods: {
	ModernRecipeBook: {
		Keybinds: {
			ToggleBook.DisplayName: Открыть книгу рецептов
			ChainBack.DisplayName: Назад
			ChainForward.DisplayName: Вперёд
		}

		Configs: {
			BookConfig: {
				DisplayName: Книга рецептов

				WindowScalePercent: {
					Label: Размер окна, %
					Tooltip: По умолчанию 90%. Уменьшается, если не помещается на экране.
				}

				TextScalePercent: {
					Label: Размер текста, %
					Tooltip: По умолчанию 100%. Меняет только текст, не окно.
				}

				InventoryAltRightClick: {
					Label: Поиск предмета средней кнопкой
					Tooltip: Средняя кнопка по предмету в любом слоте открывает его в книге. В остальных местах Mouse3 открывает книгу.
				}

				TrackerOpacityPercent: {
					Label: Непрозрачность панели отслеживания, %
					Tooltip: Только фон панели с карточками; текст и иконки всегда чёткие.
				}

				TrackerScalePercent: {
					Label: Размер панели отслеживания, %
					Tooltip: Только для карточек; компактные строки — размером текста игры.
				}

				ResourceOnlyTracker: {
					Label: Отслеживание: компактные строки
					Tooltip: Строки материалов под миникартой, как у аксессуара. Выкл.: карточки, до 5 целей.
				}

				Headers.Movement: Движение

				DoubleTapDash: {
					Label: Рывок двойным нажатием (Calamity)
					Tooltip: Двойное нажатие влево или вправо делает рывок, клавиша рывка Calamity тоже работает.
				}
			}

			BookStorageConfig: {
				DisplayName: Книга рецептов: Magic Storage

				AutoConnect: {
					Label: Автоподключение Magic Storage
					Tooltip: Открытая книга сама подключается к ближайшему хранилищу. Выкл.: кнопкой.
				}
			}

			BookServerConfig: {
				DisplayName: Книга рецептов: сервер
				Headers.QualityOfLife: Удобства

				NearbyStorage: {
					Label: Хранилища рядом
					Tooltip: Книга показывает, считает и крафтит из сундуков и Magic Storage в радиусе.
				}

				NearbyRadius: {
					Label: Радиус хранилищ (блоков)
					Tooltip: По умолчанию 30 блоков вокруг игрока.
				}

				MapTeleport: {
					Label: Телепорт по карте
					Tooltip: "Колёсико (Mouse3) по исследованной точке большой карты — телепорт туда.
Клавиша меняется в управлении."
				}
			}
		}
	}
}
