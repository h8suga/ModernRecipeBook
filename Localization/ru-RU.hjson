Mods: {
	ModernRecipeBook: {
		Keybinds: {
			ToggleBook.DisplayName: Открыть книгу рецептов
			ChainBack.DisplayName: Цепочка: назад
			ChainForward.DisplayName: Цепочка: вперёд
		}

		Configs: {
			BookConfig: {
				DisplayName: Книга рецептов

				WindowScalePercent: {
					Label: Размер окна, %
					Tooltip: По умолчанию 90%. Уменьшается, если не помещается на экране.
				}

				TextScalePercent: {
					Label: Размер текста, %
					Tooltip: По умолчанию 100%. Меняет только текст, не окно.
				}

				InventoryAltRightClick: {
					Label: Поиск предмета средней кнопкой
					Tooltip: Средняя кнопка по предмету в любом слоте открывает его в книге. В остальных местах Mouse3 открывает книгу.
				}

				TrackerOpacityPercent: {
					Label: Непрозрачность панели отслеживания, %
					Tooltip: Только фон; текст и иконки всегда чёткие.
				}

				TrackerScalePercent: {
					Label: Размер панели отслеживания, %
					Tooltip: 100% — панель шириной 300 px. Уменьшается под размер экрана.
				}

				ResourceOnlyTracker: {
					Label: Отслеживание: только материалы
					Tooltip: Один список материалов, нужных всем целям. Включается сам, если целей больше 5.
				}
			}
		}
	}
}
